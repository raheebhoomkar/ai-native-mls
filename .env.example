# Copy to .env and adjust. Never commit .env.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Hours a sign-in lasts before the user must sign in again.
SESSION_TTL_HOURS=12

# Container and demo deployment only; leave unset for local development.
# WEB_DIST_DIR=/srv/web
# SEED_DEMO_DATA=true
# SEED_PASSWORD=
# FORWARDED_ALLOW_IPS=127.0.0.1

# Local Postgres from docker-compose.yml. These credentials are for local development only.
POSTGRES_USER=mls
POSTGRES_PASSWORD=mls
POSTGRES_DB=mls
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mls:mls@localhost:5432/mls

# Uploaded media. Defaults: local disk at <repo>/var/media, 10 MB per file, files of
# removed media deleted after 7 days.
# MEDIA_STORAGE=local
# MEDIA_ROOT=
# MEDIA_RETENTION_DAYS=7
# S3-compatible storage (MEDIA_STORAGE=s3). Keep the bucket private.
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT_URL=
# MEDIA_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_MAX_BYTES=10485760
# Signs media download links; required in production (at least 32 characters).
# Unset in development: a new key per process, so links stop working after a restart.
# MEDIA_SIGNING_KEY=

# AI vision provider (Sprint 7). Without a key the API uses a demo adapter whose output is
# labelled "[Demo]". Get a key at https://aistudio.google.com/apikey. The free tier may use
# what you send to improve Google's models: send demo photos only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# AI_TIMEOUT_SECONDS=90

# Geocoder: "demo" (city centres only, labelled) or "nominatim" (OpenStreetMap; 1 request/s).
# Nominatim's usage policy asks for an identifying User-Agent with a contact.
# GEOCODER=demo
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=ai-native-mls/0.1 (contact: you@example.org)

# Semantic search embedder: "demo" (word overlap, labelled) or "gemini" (needs GEMINI_API_KEY).
# Changing it re-indexes every listing; "gemini" sends listing titles and remarks to Google.
# EMBEDDER=demo
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Where listing vectors live: "postgres" (default, no extra service) or "qdrant".
# Local Qdrant: docker compose --profile qdrant up -d. Qdrant Cloud: https URL plus API key.
# After changing EMBEDDER or VECTOR_STORE run: python -m app.modules.search.cli reindex
# VECTOR_STORE=postgres
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Hosts without an always-on worker (Vercel): a scheduler calls GET /api/v1/ops/run-jobs with
# "Authorization: Bearer <CRON_SECRET>" (16+ characters). Unset: that route answers 404.
# CRON_SECRET=
