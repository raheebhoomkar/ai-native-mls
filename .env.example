# Copy to .env and adjust. Never commit .env.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Hours a sign-in lasts before the user must sign in again.
SESSION_TTL_HOURS=12

# Container and demo deployment only; leave unset for local development.
# WEB_DIST_DIR=/srv/web
# SEED_DEMO_DATA=true
# SEED_PASSWORD=
# FORWARDED_ALLOW_IPS=127.0.0.1

# Local Postgres from docker-compose.yml. These credentials are for local development only.
POSTGRES_USER=mls
POSTGRES_PASSWORD=mls
POSTGRES_DB=mls
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mls:mls@localhost:5432/mls

# Uploaded media. Defaults: local disk at <repo>/var/media, 10 MB per file, files of
# removed media deleted after 7 days.
# MEDIA_STORAGE=local
# MEDIA_ROOT=
# MEDIA_RETENTION_DAYS=7
# S3-compatible storage (MEDIA_STORAGE=s3). Keep the bucket private.
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT_URL=
# MEDIA_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_MAX_BYTES=10485760
# Signs media download links; required in production (at least 32 characters).
# Unset in development: a new key per process, so links stop working after a restart.
# MEDIA_SIGNING_KEY=
