# Copy to .env and adjust. Never commit .env.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Hours a sign-in lasts before the user must sign in again.
SESSION_TTL_HOURS=12

# Container and demo deployment only; leave unset for local development.
# WEB_DIST_DIR=/srv/web
# SEED_DEMO_DATA=true
# SEED_PASSWORD=
# FORWARDED_ALLOW_IPS=127.0.0.1

# Local Postgres from docker-compose.yml. These credentials are for local development only.
POSTGRES_USER=mls
POSTGRES_PASSWORD=mls
POSTGRES_DB=mls
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mls:mls@localhost:5432/mls
